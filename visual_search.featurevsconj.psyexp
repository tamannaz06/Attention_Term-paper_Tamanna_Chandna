                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="Hi, this is a simple task that requires you to search for the letter T in RED font and click on it when you see it. Conditions may change, but the task remains the same.&#10;&#10;Try to be as fast and accurate as you can.&#10;&#10;Click anywhere to start!" valType="extendedStr" updates="constant" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="code" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="flip" val="" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
            <MouseComponent name="startMouse" plugin="None">
                <Param name="name" val="startMouse" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0.0" valType="code" updates="None" plugin="None"/>
