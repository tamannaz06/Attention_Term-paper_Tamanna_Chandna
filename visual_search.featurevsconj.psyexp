            </RoutineSettingsComponent>
            <TextComponent name="instrTxt" plugin="None">
                <Param name="name" val="instrTxt" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0.0" valType="code" updates="None" plugin="None"/>
